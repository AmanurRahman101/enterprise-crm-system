# Backend API URL
# For localhost: http://localhost:3000
# For LAN access: https://192.168.0.101:3000 (replace with your IP)
VITE_API_URL=http://localhost:3000

# WebSocket URL (optional - defaults to VITE_API_URL)
VITE_SOCKET_URL=

# WebSocket Host (optional - for direct WebSocket connections)
VITE_WS_HOST=localhost

# WebSocket Port (optional)
VITE_WS_PORT=3000
