# Backend API URL - HTTPS Enabled
# For localhost: https://localhost:3000
# For LAN access: Update VITE_API_URL to your IP address
VITE_API_URL=https://localhost:3000

# WebSocket URL (optional - defaults to VITE_API_URL)
VITE_SOCKET_URL=https://localhost:3000

# WebSocket Host (optional - for direct WebSocket connections)
VITE_WS_HOST=localhost

# WebSocket Port (optional)
VITE_WS_PORT=3000
