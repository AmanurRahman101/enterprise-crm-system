### ADVANCED SCENARIOS
### ==================================================

### Scenario 1: Complete Sales Activity Timeline
# Create initial outreach call
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{acmeToken}}
X-Tenant: acme

{
  "type": "CALL",
  "subject": "Cold Call - Introduction",
  "description": "Initial cold call to introduce our CRM solution.",
  "duration": 10,
  "outcome": "Connected",
  "contactId": "contact-4-acme",
  "occurredAt": "2025-01-03T10:00:00Z"
}

###
# Send follow-up email
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{acmeToken}}
X-Tenant: acme

{
  "type": "EMAIL",
  "subject": "Follow-up: CRM Introduction",
  "description": "Sent information packet about our CRM features and pricing.",
  "contactId": "contact-4-acme",
  "occurredAt": "2025-01-03T14:00:00Z"
}

###
# Schedule meeting
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{acmeToken}}
X-Tenant: acme

{
  "type": "MEETING",
  "subject": "Product Demo Scheduled",
  "description": "Scheduled product demo for next week.",
  "duration": 60,
  "contactId": "contact-4-acme",
  "occurredAt": "2025-01-04T16:00:00Z"
}

### Scenario 2: Customer Support Activity Log
# Log support call
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{acmeToken}}
X-Tenant: acme

{
  "type": "CALL",
  "subject": "Support: Data Import Issue",
  "description": "Customer having issues importing contacts from CSV. Walked through import process step-by-step.",
  "duration": 25,
  "outcome": "Issue Resolved",
  "contactId": "contact-5-acme",
  "ticketId": "ticket-2-acme",
  "occurredAt": "2025-01-05T09:30:00Z"
}

###
# Add follow-up note
POST {{baseUrl}}/api/activities
Content-Type: application/json
Authorization: Bearer {{acmeToken}}
X-Tenant: acme

{
  "type": "NOTE",
  "subject": "Follow-up Required",
  "description": "Need to follow up tomorrow to ensure import completed successfully.",
  "contactId": "contact-5-acme",
  "ticketId": "ticket-2-acme",
  "occurredAt": "2025-01-05T10:00:00Z"
}

