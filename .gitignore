# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build outputs
dist/
build/

# Logs
logs/
*.log

# Database
*.sql.backup
*.db

# Temporary files
tmp/
temp/
*.tmp

# Documentation backups
*.md.backup

# Uploads (keep directory structure but ignore files)
Backend/uploads/*
!Backend/uploads/.gitkeep

# SSL Certificates (should not be committed)
Backend/cert/*.crt
Backend/cert/*.key
Frontend/cert/*.crt
Frontend/cert/*.key
!Backend/cert/.gitkeep
!Frontend/cert/.gitkeep
