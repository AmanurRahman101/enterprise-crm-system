# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tawasol_crm
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Agora Configuration (Required for voice calls)
# Get your credentials from https://console.agora.io/
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Google Gemini AI Configuration (Optional - for chatbot)
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Telegram Bot Configuration (Optional - for Telegram integration)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Server Configuration
NODE_ENV=development
PORT=3000
